# =============================================================================
# Agency Intelligence — variáveis de ambiente (EXEMPLO)
# Copie para .env.local e preencha. NUNCA commitar valores reais (ver .gitignore).
# Configuração ausente deve gerar diagnóstico de configuração, nunca simulação.
# =============================================================================

# ---- Supabase (público — expostos ao browser) ------------------------------
# Apenas URL e chave pública anon são permitidas com prefixo NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<supabase-anon-key>"

# ---- Supabase (servidor — NUNCA expor ao browser) --------------------------
# service_role NÃO é atalho geral (TEN-06). Usado só por workers/admin auditados.
SUPABASE_SERVICE_ROLE_KEY="<supabase-service-role-key>"
# String de conexão via pooler para funções serverless (transaction mode).
SUPABASE_DB_POOLER_URL="postgres://postgres.<ref>:<pwd>@<host>:6543/postgres"

# ---- Cofre / criptografia por tenant (ADR-0004) ----------------------------
# Chave versionada mantida no Supabase Vault; referência apenas.
VAULT_KEY_ID="v1"

# ---- Segredo interno do dispatcher / workers -------------------------------
# Autentica cron/dispatcher -> worker. Rotacionável.
INTERNAL_DISPATCHER_SECRET="<random-32b-hex>"

# ---- OAuth: Google Ads ------------------------------------------------------
GOOGLE_ADS_CLIENT_ID=""
GOOGLE_ADS_CLIENT_SECRET=""
GOOGLE_ADS_DEVELOPER_TOKEN=""
GOOGLE_ADS_REDIRECT_URI=""

# ---- OAuth: Meta Ads --------------------------------------------------------
META_APP_ID=""
META_APP_SECRET=""
META_REDIRECT_URI=""
META_ADS_API_VERSION="v21.0"

# ---- CRM: Kommo (etapa 2) ---------------------------------------------------
KOMMO_CLIENT_ID=""
KOMMO_CLIENT_SECRET=""
KOMMO_REDIRECT_URI=""

# ---- CRM: HubSpot (etapa 2) -------------------------------------------------
HUBSPOT_CLIENT_ID=""
HUBSPOT_CLIENT_SECRET=""
HUBSPOT_REDIRECT_URI=""

# ---- Analytics: GA4 (etapa 2) ----------------------------------------------
GA4_OAUTH_CLIENT_ID=""
GA4_OAUTH_CLIENT_SECRET=""

# ---- IA (adapter de provedor) ----------------------------------------------
# Escolha do provedor em configuração; implementação inicial anthropic|openai.
AI_PROVIDER="anthropic"
AI_MODEL="claude-sonnet-4-5"
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
# Teto monetário interno por organização (unidade: centavos BRL).
AI_ORG_MONTHLY_BUDGET_CENTS="50000"

# ---- Pagamento (adapter — externo à stack de hospedagem) -------------------
BILLING_PROVIDER="stripe"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ---- Email (adapter) --------------------------------------------------------
EMAIL_PROVIDER=""
EMAIL_FROM=""
RESEND_API_KEY=""

# ---- Aplicação --------------------------------------------------------------
APP_BASE_URL="http://localhost:3000"
NODE_ENV="development"
