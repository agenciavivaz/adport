{
  "name": "agency-intelligence",
  "version": "0.1.0",
  "private": true,
  "description": "SaaS de inteligência de mídia, vendas e retenção para agências (base Adport, stack Supabase/Vercel/GitHub).",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm -r --filter=./packages/* build && pnpm --filter @ai/cloud build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "dev": "pnpm --filter @ai/cloud dev",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,sql}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,sql}\""
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "prettier": "3.4.2",
    "typescript": "5.7.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
